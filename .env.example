# Piste environment — copy to `.env.local` and fill in. NEVER commit that copy.
# `.env.local` is what the make / npm scripts read. Secrets live only there (and
# in your CI secret store), never in the committed repo.
#
# As shipped, this file runs the app against your own machine: copy it, then
# `npm run db:start && npm run dev` and you have a working app with seeded test logins.
# See docs/development.md.
#
# The local values below are NOT deployable — the production build refuses a
# bundle pointing at 127.0.0.1 (src/vite/build-env.ts). Replace them, and fill
# in the sections beneath, when you go live: docs/deployment.md.

# ── Client build (baked into the bundle by Vite) ─────────────────────────────
# Local development — works as-is against `npm run db:start`. Neither is secret: the
# anon key is the Supabase CLI's fixed local demo key, published in their docs.
VITE_SUPABASE_URL=http://127.0.0.1:64521
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Deploying? Replace the two above with your own:
#   VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional — push notifications stay off if unset. Generate a VAPID pair with
# `npx web-push generate-vapid-keys`; only the public half belongs in a bundle.
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_WORKER_URL=

# Optional — the meetup planner's map tiles and the venue geocoder. Unset, the
# planner still ranks points and venues; it just draws them on a plain canvas
# instead of a map. See docs/meetup.md.
VITE_MAP_TILE_URL=
VITE_GEOCODER_URL=

# ── Supabase (migrations, verify) ────────────────────────────────────────────
# Not read by local development — `npm run db:start` needs none of them.
# From https://supabase.com/dashboard (signed in as 504068014080@tutanota.com).
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token
# Session pooler host, for direct psql. Dashboard → Project Settings → Database.
SUPABASE_POOLER_HOST=aws-x-region.pooler.supabase.com

# ── Cloudflare (deploy, via wrangler) ────────────────────────────────────────
# From https://dash.cloudflare.com (signed in as 504068014080@tutanota.com).
# The API token needs: Workers Scripts:Edit, Workers KV:Edit, Account:Read.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ── Push worker secrets (set via `wrangler secret put` in workers/push) ──────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: URL identifying the sender to the push service.
VAPID_SUBJECT=mailto:you@example.com
# Server-side only — bypasses RLS. Never in a bundle, never in a VITE_ var.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token the admin broadcast endpoint checks before it will send.
ADMIN_TRIGGER_SECRET=
# Optional relay for admin broadcasts (a LINE Notify / Discord webhook).
BROADCAST_WEBHOOK_URL=

# ── Supabase Edge Function secrets (set via `supabase secrets set`) ──────────
# Used by the registration + notification functions. For `supabase functions
# serve` locally the mail values need not be real — local mail is captured by
# Mailpit at http://127.0.0.1:64524.
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=your-app-password
