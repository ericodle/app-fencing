{
  "name": "app-fencing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Club management app for Sheshouzuo Fencing Club",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run typecheck && npm run lint && node scripts/require-local-stack.mjs && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/require-local-stack.mjs && vitest run --project integration",
    "test:scenario": "node scripts/require-local-stack.mjs && vitest run --project scenario",
    "smoke": "node scripts/smoke.mjs",
    "preflight": "npm run test && npm run smoke",
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:status": "node scripts/supabase.mjs status",
    "db:reset": "node scripts/supabase.mjs --require-local db reset",
    "db:diff": "node scripts/supabase.mjs --require-local db diff",
    "db:types": "node scripts/gen-types.mjs",
    "db:push": "dotenv -e .env.local -- node scripts/supabase.mjs --remote db push",
    "db:auth": "dotenv -e .env.local -- node scripts/configure-auth.mjs",
    "db:verify": "dotenv -e .env.local -- node scripts/supabase.mjs --remote db diff --schema public",
    "db:backup": "node scripts/backup-db.mjs",
    "deploy": "npm run deploy:functions && npm run deploy:app && npm run deploy:push",
    "deploy:app": "npm run build && dotenv -e .env.production -- wrangler deploy",
    "deploy:push": "cd workers/push && npm ci --no-audit --no-fund && npx dotenv -e ../../.env.production -- npx wrangler deploy --secrets-file ../../.env.push",
    "deploy:functions": "dotenv -e .env.local -- sh -c 'node scripts/supabase.mjs functions deploy --project-ref \"$SUPABASE_PROJECT_REF\"'"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.110.1",
    "date-fns": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.63.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-precaching": "^7.4.1",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
